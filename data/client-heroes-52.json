  "unlockDescriptions": [
    {
      "id": "maddy",
      "level": 10,
      "descriptions": {
        "ko": "전투 스킬 시전 시 아군 전체 영웅의 공격력이 7.5% 증가하며, 지속 시간은 전투 스킬 효과와 동일합니다.",
        "en": "When using an Active Skill, increases all allies' Attack by +7.5% for the same duration as the Active Skill effect.",
        "ja": "アクティブ発動時、味方全英雄の攻撃力+7.5% 。持続時間はアクティブ効果と同じです",
        "ru": "При использовании боевого навыка увеличивает атаку всех союзников на 7.5% на время действия боевого навыка.",
        "zh-tw": "施放戰技時，我方全體英雄攻擊+7.5%，持續時間和戰技效果相同。",
        "de": "Beim Einsatz einer aktiven Fähigkeit erhöht sich der Angriff aller Verbündeten um +7.5 % für die gleiche Dauer wie der Effekt der aktiven Fähigkeit."
      }
    },
    {
      "id": "mike",
      "level": 15,
      "descriptions": {
        "ko": "체력이 5% 증가하고 체력이 매번 10% 감소하며, 1%의 전투 스킬 대미지 감소를 획득합니다.",
        "en": "Health +5%. Gain 1% Active Skill Damage Reduction for every 10% of Health lost.",
        "ja": "HPが5%増加する。HPが10%減少するたびに1%のアクティブスキル被ダメージ軽減を獲得する",
        "ru": "+5% к здоровью. Кажд. 10% потерянного здоровья снижают урон при использ. активного навыка на 1%.",
        "zh-tw": "生命值+5%，血量每降低10%，獲得1%的戰技傷害減免",
        "de": "Zustand +5 %. Erhalte 1 % Schadensreduzierung von aktiven Fähigkeiten für jede 10 % verlorenen Zustands."
      }
    }
  ],
